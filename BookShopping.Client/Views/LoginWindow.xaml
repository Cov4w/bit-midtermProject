<Window x:Class="BookShopping.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BOOKSHOP - SIGN IN" Height="600" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F7F8FA" FontFamily="Malgun Gothic">

    <Window.Resources>
        <!-- 댄디 & 모던 컬러 팔레트 정의 -->
        <SolidColorBrush x:Key="NavyAccent" Color="#1B2A4A"/>
        <SolidColorBrush x:Key="NavyHover" Color="#263B66"/>
        <SolidColorBrush x:Key="CharcoalBlack" Color="#18181B"/>
        <SolidColorBrush x:Key="SubTextGray" Color="#6E717A"/>
        <SolidColorBrush x:Key="BorderGray" Color="#DCDFE6"/>

        <!-- 입력창(TextBox) 공통 스타일 -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource CharcoalBlack}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <!-- 포커스 시 어두운 네이비 테두리로 포인트 -->
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource NavyAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 비밀번호창(PasswordBox) 공통 스타일 -->
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource CharcoalBlack}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGray}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource NavyAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 메인 버튼 스타일 (어두운 네이비 솔리드) -->
        <Style x:Key="PrimaryNavyButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource NavyAccent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NavyHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 보조 버튼 스타일 (화이트 배경 + 블랙/네이비 라인) -->
        <Style x:Key="SecondaryOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource CharcoalBlack}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CharcoalBlack}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2F4F7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- 외곽 메인 카드 영역 -->
    <Grid Margin="30">
        <Border Background="#FFFFFF" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="35,30">
            <StackPanel VerticalAlignment="Center">
                <!-- 상단 브랜드 타이틀 -->
                <Border BorderBrush="{StaticResource NavyAccent}" BorderThickness="0,0,0,2" Padding="0,0,0,12" Margin="0,0,0,28">
                    <StackPanel>
                        <TextBlock Text="THE BOOK ARCHIVE" FontSize="20" FontWeight="Bold" Foreground="{StaticResource CharcoalBlack}"/>
                        <TextBlock Text="System Access &amp; Membership" FontSize="11" Foreground="{StaticResource SubTextGray}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 아이디 입력 (txtId) -->
                <TextBlock Text="아이디 (ID)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CharcoalBlack}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtId" Margin="0,0,0,16"/>

                <!-- 비밀번호 입력 (txtPassword) -->
                <TextBlock Text="비밀번호 (PASSWORD)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CharcoalBlack}" Margin="0,0,0,6"/>
                <PasswordBox x:Name="txtPassword" Margin="0,0,0,16" KeyDown="txtPassword_KeyDown"/>

                <!-- 이름 입력 - 회원가입 시 사용 (txtName) -->
                <TextBlock Text="성명 (회원가입 시 입력)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SubTextGray}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtName" Margin="0,0,0,28"/>

                <!-- 로그인 & 회원가입 버튼 (btnLogin, btnRegister) -->
                <Button x:Name="btnLogin" Content="로그인" Style="{StaticResource PrimaryNavyButton}" Click="btnLogin_Click" Margin="0,0,0,10"/>
                <Button x:Name="btnRegister" Content="신규 회원가입" Style="{StaticResource SecondaryOutlineButton}" Click="btnRegister_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>