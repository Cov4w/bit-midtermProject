<Window x:Class="BookShopping.Client.Views.CustomerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookShopping.Client.Views"
        mc:Ignorable="d"
        Title="THE BOOK ARCHIVE - CUSTOMER" Height="900" Width="1650"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA" FontFamily="Malgun Gothic">

    <Window.Resources>
        <!-- 컬러 정의 -->
        <SolidColorBrush x:Key="NavyAccent" Color="#1B2A4A"/>
        <SolidColorBrush x:Key="NavyHover" Color="#263B66"/>
        <SolidColorBrush x:Key="CharcoalBlack" Color="#18181B"/>
        <SolidColorBrush x:Key="DarkHeader" Color="#141619"/>
        <SolidColorBrush x:Key="BorderGray" Color="#E2E5EC"/>
        <SolidColorBrush x:Key="SubTextGray" Color="#6E717A"/>

        <!-- 기본 입력창 스타일 -->
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource CharcoalBlack}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource NavyAccent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 네이비 포인트 버튼 -->
        <Style x:Key="NavyButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource NavyAccent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NavyHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 차콜 블랙/화이트 라인 보조 버튼 -->
        <Style x:Key="DarkOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource CharcoalBlack}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CharcoalBlack}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="2" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F2F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- GridView 헤더 스타일 (화이트 배경 + 하단 네이비 보더) -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#FAFAFC"/>
            <Setter Property="Foreground" Value="{StaticResource CharcoalBlack}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGray}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <!-- ListViewItem 행 스타일 -->
        <Style TargetType="ListViewItem">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource CharcoalBlack}"/>
            <Setter Property="BorderBrush" Value="#F0F2F5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F6F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EBF0F7"/>
                    <Setter Property="Foreground" Value="{StaticResource NavyAccent}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 미니멀 탭 아이템 스타일 -->
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SubTextGray}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="20,10" Margin="0,0,8,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource NavyAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource NavyAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource CharcoalBlack}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ==================== 상단 다크 메뉴바 영역 ==================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource DarkHeader}" Padding="16,6">
            <DockPanel>
                <TextBlock Text="THE BOOK ARCHIVE" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,25,0"/>
                <TextBlock x:Name="topBookCount" Text="도서 수 : " Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,25,0"/>
                <Menu Background="Transparent" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center">
                    <MenuItem Header="계정 메뉴(_M)" Foreground="#E4E7EC">
                        <MenuItem x:Name="menuLogout" Header="로그아웃" Foreground="#18181B" Click="cusLogout_Click"/>
                        <Separator/>
                        <MenuItem x:Name="menuExit" Header="프로그램 종료" Foreground="#18181B" Click="menuExit_Click"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- ==================== 메인 탭 영역 (탭 전환 시 SelectionChanged 이벤트 연결) ==================== -->
        <TabControl x:Name="cusTabControl" Margin="24,16,24,24" Background="Transparent" BorderThickness="0" SelectionChanged="cusTabControl_SelectionChanged">

            <!-- ========================================================================= -->
            <!-- 탭 1: 도서 스토어 (좌측: 검색 및 도서 리스트 / 우측: 표지 및 AI 요약)     -->
            <!-- ========================================================================= -->
            <TabItem Header="도서 스토어">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="0.85*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ==================== 1. 좌측: 도서 검색 및 목록 카드 ==================== -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="42"/>
                            </Grid.RowDefinitions>

                            <!-- 상단 검색 필터 바 -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="75"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="도서명" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CharcoalBlack}" Margin="0,0,8,0" Grid.Column="0"/>
                                <TextBox x:Name="txtSearch" Grid.Column="1" ToolTip="도서 제목 키워드"/>

                                <TextBox x:Name="txtMinPrice" HorizontalContentAlignment="Center" Grid.Column="3" ToolTip="최소 가격"/>
                                <TextBlock Text="~" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource SubTextGray}" Grid.Column="4"/>
                                <TextBox x:Name="txtMaxPrice" HorizontalContentAlignment="Center" Grid.Column="5" ToolTip="최대 가격"/>

                                <ComboBox x:Name="cbCategory" VerticalContentAlignment="Center" FontSize="13" Grid.Column="7" BorderBrush="#D0D5DD" Background="#FFFFFF"/>

                                <Button x:Name="btnSearch" Content="조회" Style="{StaticResource NavyButton}" Grid.Column="9" Click="btnSearch_Click"/>

                                <TextBlock Text="수집P" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource SubTextGray}" Margin="0,0,6,0" Grid.Column="11"/>
                                <TextBox x:Name="txtPage" HorizontalContentAlignment="Center" Grid.Column="12" ToolTip="동기화 페이지 수"/>
                                <Button x:Name="btnRefresh" Content="동기화" Style="{StaticResource DarkOutlineButton}" Grid.Column="14" Click="btnRefresh_Click"/>
                            </Grid>

                            <!-- 중앙: 상품 리스트 뷰 -->
                            <ListView x:Name="lbProducts" Grid.Row="2" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Background="#FFFFFF" SelectionChanged="lbProducts_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="ISBN" Width="130" DisplayMemberBinding="{Binding Isbn}"/>
                                        <GridViewColumn Header="도서명" Width="250" DisplayMemberBinding="{Binding BookName}"/>
                                        <GridViewColumn Header="카테고리" Width="110" DisplayMemberBinding="{Binding CategoryName}"/>
                                        <GridViewColumn Header="판매가(원)" Width="105" DisplayMemberBinding="{Binding BookPrice}"/>
                                        <GridViewColumn Header="재고" Width="80" DisplayMemberBinding="{Binding BookCount}"/>
                                        <GridViewColumn Header="판매 상태" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsForSale}" IsEnabled="False" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <!-- 하단: 수량 입력 및 장바구니 담기 -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="주문 수량" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource CharcoalBlack}" Margin="0,0,10,0" Grid.Column="0"/>
                                <TextBox x:Name="txtQuantity" HorizontalContentAlignment="Center" FontSize="14" Grid.Column="1"/>
                                <Button x:Name="btnAdd" Content="장바구니에 담기" Style="{StaticResource NavyButton}" Grid.Column="3" Click="btnAdd_Click"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ==================== 2. 우측: 도서 프리뷰 및 AI 큐레이션 요약 카드 ==================== -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="24">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="320"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="40"/>
                                <RowDefinition Height="20"/>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="10"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 섹션 헤더 -->
                            <Border BorderBrush="{StaticResource CharcoalBlack}" BorderThickness="0,0,0,2" Padding="0,0,0,8" Grid.Row="0">
                                <TextBlock Text="BOOK PREVIEW &amp; AI SUMMARY" FontSize="14" FontWeight="Bold" Foreground="{StaticResource CharcoalBlack}"/>
                            </Border>

                            <!-- 표지 이미지 영역 -->
                            <Border Grid.Row="2" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Background="#F7F8FA" Padding="16">
                                <Image x:Name="imgBookPreview" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <!-- 외부 상세 링크 버튼 -->
                            <Button x:Name="btnOpenBookUrl" Content="카카오 도서 상세페이지 열기 ↗" Style="{StaticResource DarkOutlineButton}" Grid.Row="4" Click="btnOpenBookUrl_Click"/>

                            <!-- [추가된 부분] 도서 상세 명세 타이틀 + 우측 AI 요약 버튼 배치 -->
                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="도서 상세 명세 (AI 큐레이션)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NavyAccent}" VerticalAlignment="Center" Grid.Column="0"/>
                                <Button x:Name="btnAiSummary" Content="AI 요약 생성" Style="{StaticResource NavyButton}" Height="30" FontSize="12" Grid.Column="1" Click="btnAiSummary_Click"/>
                            </Grid>

                            <!-- 도서 설명 요약 텍스트박스 (새로 만든 AI API 응답이 출력될 공간) -->
                            <TextBox x:Name="txtBookSummary" Grid.Row="8" IsReadOnly="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Padding="14" FontSize="13" Background="#F7F8FA" BorderBrush="{StaticResource BorderGray}"
                                     VerticalContentAlignment="Top"
                                     Text="좌측 목록에서 도서를 선택한 후 [AI 요약 생성] 버튼을 누르면 수석 사서 AI의 3줄 핵심 큐레이션이 표시됩니다."/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- 탭 2: 장바구니 및 결제                                                    -->
            <!-- ========================================================================= -->
            <TabItem Header="장바구니 및 결제">
                <Border Margin="0,16,0,0" Background="#FFFFFF" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="28">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="46"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="48"/>
                        </Grid.RowDefinitions>

                        <!-- 상단: 타이틀 & 계좌 잔액 표시 -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="SHOPPING CART" FontSize="16" FontWeight="Bold" Foreground="{StaticResource CharcoalBlack}"/>
                                <TextBlock Text="담아둔 도서의 수량과 결제 예정 금액을 확인하세요." FontSize="12" Foreground="{StaticResource SubTextGray}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBox x:Name="txtBalance" Text="잔액" IsReadOnly="True" Grid.Column="1"
                                     Background="#F7F8FA" BorderBrush="{StaticResource NavyAccent}" BorderThickness="1.5"
                                     FontWeight="Bold" Foreground="{StaticResource NavyAccent}"
                                     HorizontalContentAlignment="Center" FontSize="14"/>
                        </Grid>

                        <!-- 중앙: 장바구니 리스트뷰 -->
                        <ListView x:Name="lbCart" Grid.Row="2" BorderBrush="{StaticResource BorderGray}" BorderThickness="1">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ISBN" Width="200" DisplayMemberBinding="{Binding ISBN}"/>
                                    <GridViewColumn Header="도서명" Width="520" DisplayMemberBinding="{Binding BookName}"/>
                                    <GridViewColumn Header="주문 수량" Width="160" DisplayMemberBinding="{Binding OrderCount}"/>
                                    <GridViewColumn Header="단가(원)" Width="200" DisplayMemberBinding="{Binding BookPrice}"/>
                                    <GridViewColumn Header="합계 금액(원)" Width="220" DisplayMemberBinding="{Binding TotalPrice}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- 하단 1: 정산 요약 바 & 선택 삭제 버튼 -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="txtTotalCount" Text="총 수량" IsReadOnly="True" Background="#F7F8FA" FontWeight="SemiBold" HorizontalContentAlignment="Center" Grid.Column="0"/>
                            <TextBox x:Name="txtTotalPrice" Text="총 금액" IsReadOnly="True" Background="#F7F8FA" FontWeight="SemiBold" HorizontalContentAlignment="Center" Grid.Column="2"/>
                            <TextBox x:Name="txtAfterBalance" Text="결제 후 잔액" IsReadOnly="True" Background="#F7F8FA" FontWeight="SemiBold" HorizontalContentAlignment="Center" Grid.Column="4"/>
                            <Button x:Name="btnDelete" Content="선택 상품 삭제" Style="{StaticResource DarkOutlineButton}" Grid.Column="6" Click="btnDelete_Click"/>
                        </Grid>

                        <!-- 하단 2: 최종 결제 버튼 -->
                        <Button x:Name="btnPay" Content="장바구니 전체 결제하기" Style="{StaticResource NavyButton}" FontSize="15" Grid.Row="6" Click="btnPay_Click"/>
                    </Grid>
                </Border>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- [신규 추가] 탭 3: 마이페이지 및 AI 분석 (3단 분할 레이아웃)               -->
            <!-- ========================================================================= -->
            <TabItem Header="마이페이지 및 AI 분석">
                <Grid Margin="0,16,0,0">
                    <!-- 3가지 구역 균등 및 비율 분할 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <!-- 구역 1: 내 결제 내역 및 결제 상세 -->
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.05*"/>
                        <!-- 구역 2: 도서 성향 분석 시각화 -->
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="1.1*"/>
                        <!-- 구역 3: AI 사서 실시간 채팅 -->
                    </Grid.ColumnDefinitions>

                    <!-- ==================== 구역 1: 로그인 고객 본인의 결제 내역 & 상세 내역 ==================== -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="18"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 1-1. 상단: 내 결제 내역 목록 -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="{StaticResource NavyAccent}" BorderThickness="0,0,0,2" Padding="0,0,0,6">
                                        <TextBlock Text="MY ORDER HISTORY (결제 내역)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NavyAccent}"/>
                                    </Border>
                                    <Button x:Name="btnRefreshHistory" Content="내역 새로고침" Style="{StaticResource DarkOutlineButton}" Height="26" FontSize="11" Grid.Column="1" Click="btnRefreshHistory_Click"/>
                                </Grid>

                                <ListView x:Name="lvMyOrderHistory" Grid.Row="2" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" SelectionChanged="lvMyOrderHistory_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="결제번호" Width="80" DisplayMemberBinding="{Binding PayId}"/>
                                            <GridViewColumn Header="결제일시" Width="190" DisplayMemberBinding="{Binding PayDate}"/>
                                            <GridViewColumn Header="결제금액(원)" Width="140" DisplayMemberBinding="{Binding PayMoney}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- 1-2. 하단: 선택한 결제의 상세 구매 도서 내역 -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border BorderBrush="{StaticResource CharcoalBlack}" BorderThickness="0,0,0,2" Padding="0,0,0,6" Grid.Row="0">
                                    <TextBlock Text="ORDER DETAILS (결제 상세 품목)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource CharcoalBlack}"/>
                                </Border>

                                <ListView x:Name="lvMyPaymentDetails" Grid.Row="2" BorderBrush="{StaticResource BorderGray}" BorderThickness="1">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="ISBN" Width="125" DisplayMemberBinding="{Binding Isbn}"/>
                                            <GridViewColumn Header="도서명" Width="185" DisplayMemberBinding="{Binding BookName}"/>
                                            <GridViewColumn Header="수량" Width="60" DisplayMemberBinding="{Binding BookCount}"/>
                                            <GridViewColumn Header="단가(원)" Width="95" DisplayMemberBinding="{Binding BookUnitPrice}" />
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ==================== 구역 2: 고객 도서 성향 AI 분석 및 시각화 ==================== -->
                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="84"/>
                                <!-- 상단 KPI 요약 배지 3개 -->
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="1.1*"/>
                                <!-- 카테고리 비중 수평 바 차트 영역 -->
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="0.9*"/>
                                <!-- AI 성향 종합 분석 텍스트 리포트 -->
                            </Grid.RowDefinitions>

                            <!-- 상단 헤더 & AI 분석 실행 버튼 -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border BorderBrush="{StaticResource CharcoalBlack}" BorderThickness="0,0,0,2" Padding="0,0,0,8">
                                    <TextBlock Text="READING TENDENCY ANALYTICS" FontSize="13" FontWeight="Bold" Foreground="{StaticResource CharcoalBlack}"/>
                                </Border>
                                <Button x:Name="btnAnalyzeTendency" Content="AI 성향 분석 실행" Style="{StaticResource NavyButton}" Height="30" FontSize="12" Margin="10,0,0,0" Grid.Column="1" Click="btnAnalyzeTendency_Click"/>
                            </Grid>

                            <!-- 요약 지표 카드 3종 (총 구매 권수, 최다 선호 분야, 평균 구매 단가) -->
                            <UniformGrid Grid.Row="2" Columns="3" Rows="1">
                                <Border Background="#F7F8FA" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Margin="0,0,6,0" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="누적 구매 도서" FontSize="11" Foreground="{StaticResource SubTextGray}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtStatTotalBooks" Text="- 권" FontSize="16" FontWeight="Bold" Foreground="{StaticResource CharcoalBlack}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F7F8FA" BorderBrush="{StaticResource NavyAccent}" BorderThickness="1.5" Margin="3,0" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="핵심 선호 분야" FontSize="11" Foreground="{StaticResource NavyAccent}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtStatTopCategory" Text="분석 대기" FontSize="15" FontWeight="Bold" Foreground="{StaticResource NavyAccent}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F7F8FA" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Margin="6,0,0,0" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="총 누적 결제액" FontSize="11" Foreground="{StaticResource SubTextGray}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="txtStatTotalSpent" Text="- 원" FontSize="15" FontWeight="Bold" Foreground="{StaticResource CharcoalBlack}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- 카테고리별 구매 분포 시각화 차트 (ProgressBar 기반 깔끔한 모던 바 차트) -->
                            <Border Grid.Row="4" Background="#FAFAFC" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="16">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="분야별 도서 구매 비중 (Category Distribution)" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CharcoalBlack}" Margin="0,0,0,12"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="icCategoryChart">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="75"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="80"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource CharcoalBlack}" VerticalAlignment="Center" Grid.Column="0"/>
                                                        <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="12" Grid.Column="1"
                                                                     Background="#E6E8F0" Foreground="{StaticResource NavyAccent}" BorderThickness="0"/>
                                                        <TextBlock Text="{Binding DisplayPercent}" FontSize="11" Foreground="{StaticResource SubTextGray}" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="2"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- AI 성향 분석 리포트 타이틀 -->
                            <TextBlock Text="AI 큐레이터 성향 진단 리포트" FontSize="12" FontWeight="Bold" Foreground="{StaticResource NavyAccent}" Grid.Row="6"/>

                            <!-- AI 성향 분석 텍스트 결과창 -->
                            <TextBox x:Name="txtTendencyReport" Grid.Row="8" IsReadOnly="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     Padding="12" FontSize="13" Background="#F7F8FA" BorderBrush="{StaticResource BorderGray}"
                                     VerticalContentAlignment="Top"
                                     Text="[AI 성향 분석 실행] 버튼을 누르면 고객님의 결제 내역과 상세 구매 도서를 바탕으로 독서 성향 및 추천 도서 리포트를 생성합니다."/>
                        </Grid>
                    </Border>

                    <!-- ==================== 구역 3: AI API 실시간 채팅 영역 ==================== -->
                    <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="42"/>
                            </Grid.RowDefinitions>

                            <!-- 상단 헤더 -->
                            <Border BorderBrush="{StaticResource NavyAccent}" BorderThickness="0,0,0,2" Padding="0,0,0,8" Grid.Row="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="AI CURATOR CHAT (도서 상담 챗봇)" FontSize="13" FontWeight="Bold" Foreground="{StaticResource NavyAccent}"/>
                                </StackPanel>
                            </Border>

                            <!-- 중앙: 채팅 대화 내역 리스트박스 -->
                            <Border Grid.Row="2" Background="#F7F8FA" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="12">
                                <ListBox x:Name="lbAiChat" Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Focusable" Value="False"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="0,4"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 채팅 말풍선 카드 -->
                                            <Border Background="{Binding BubbleBackground}" BorderBrush="{Binding BubbleBorder}" BorderThickness="1" CornerRadius="3" Padding="12,10" Margin="0,2">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Sender}" FontSize="11" FontWeight="Bold" Foreground="{Binding SenderForeground}" Margin="0,0,0,4"/>
                                                    <TextBlock Text="{Binding Message}" FontSize="13" Foreground="{Binding TextForeground}" TextWrapping="Wrap" LineHeight="20"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <!-- 하단: 메시지 입력창 및 전송 버튼 -->
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="85"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="txtChatInput" Grid.Column="0" ToolTip="AI 사서에게 질문이나 추천받고 싶은 도서 주제를 입력하세요." KeyDown="txtChatInput_KeyDown"/>
                                <Button x:Name="btnSendChat" Content="전송" Style="{StaticResource NavyButton}" Grid.Column="2" Click="btnSendChat_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>