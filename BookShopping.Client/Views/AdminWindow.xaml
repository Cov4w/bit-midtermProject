<Window x:Class="BookShopping.Client.Views.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BookShopping.Client.Views"
        mc:Ignorable="d"
        Title="THE BOOK ARCHIVE - ADMINISTRATOR" Height="900" Width="1650"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA" FontFamily="Malgun Gothic">

    <Window.Resources>
        <SolidColorBrush x:Key="NavyAccent" Color="#1B2A4A"/>
        <SolidColorBrush x:Key="NavyHover" Color="#263B66"/>
        <SolidColorBrush x:Key="CharcoalBlack" Color="#18181B"/>
        <SolidColorBrush x:Key="DarkHeader" Color="#141619"/>
        <SolidColorBrush x:Key="BorderGray" Color="#E2E5EC"/>
        <SolidColorBrush x:Key="SubTextGray" Color="#6E717A"/>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource CharcoalBlack}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D5DD"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="NavyButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource NavyAccent}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="2" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource NavyHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DarkOutlineButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource CharcoalBlack}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CharcoalBlack}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="2" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F2F5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="#FAFAFC"/>
            <Setter Property="Foreground" Value="{StaticResource CharcoalBlack}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderGray}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>

        <Style TargetType="ListViewItem">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{StaticResource CharcoalBlack}"/>
            <Setter Property="BorderBrush" Value="#F0F2F5"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F4F6F9"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EBF0F7"/>
                    <Setter Property="Foreground" Value="{StaticResource NavyAccent}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource SubTextGray}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent" BorderThickness="0,0,0,3" BorderBrush="Transparent" Padding="20,10" Margin="0,0,8,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource NavyAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource NavyAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ==================== 상단 관리자 다크 헤더 & 메뉴바 ==================== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource DarkHeader}" Padding="16,6">
            <DockPanel>
                <TextBlock Text="ADMINISTRATION CONSOLE" Foreground="#FFFFFF" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,25,0"/>
                <Menu Background="Transparent" Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center">
                    <MenuItem Header="관리 메뉴(_M)" Foreground="#E4E7EC">
                        <MenuItem x:Name="menuCustomerTab" Header="고객 관리" Foreground="#18181B" Click="menuCustomerTab_Click"/>
                        <MenuItem x:Name="menuBookTab" Header="도서 판매 관리" Foreground="#18181B" Click="menuBookTab_Click"/>
                        <Separator/>
                        <MenuItem x:Name="menuLogout" Header="로그아웃" Foreground="#18181B" Click="menuLogout_Click"/>
                        <MenuItem x:Name="menuExit" Header="종료" Foreground="#18181B" Click="menuExit_Click"/>
                    </MenuItem>
                </Menu>
            </DockPanel>
        </Border>

        <!-- ==================== 관리자 메인 탭 컨트롤 ==================== -->
        <TabControl x:Name="mainTabControl" Margin="24,16,24,24" Background="Transparent" BorderThickness="0" SelectionChanged="mainTabControl_SelectionChanged">

            <!-- ========================================================================= -->
            <!-- 탭 1: 고객 관리 및 결제 내역 조회                                         -->
            <!-- ========================================================================= -->
            <TabItem Header="고객 관리">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 좌측: 전체 회원 목록 및 회원 검색/삭제 제어 -->
                    <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="22">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="14"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border BorderBrush="{StaticResource CharcoalBlack}" BorderThickness="0,0,0,2" Padding="0,0,0,8" Grid.Row="0">
                                <TextBlock Text="REGISTERED MEMBERS" FontSize="14" FontWeight="Bold" Foreground="{StaticResource CharcoalBlack}"/>
                            </Border>

                            <!-- 회원 목록 리스트뷰 (CustomersView) -->
                            <ListView x:Name="CustomersView" Grid.Row="2" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" SelectionChanged="CustomersView_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="회원 ID" Width="160" DisplayMemberBinding="{Binding cusID}"/>
                                        <GridViewColumn Header="회원 성명" Width="180" DisplayMemberBinding="{Binding cusName}"/>
                                        <GridViewColumn Header="보유 잔액(원)" Width="180" DisplayMemberBinding="{Binding cusMoney}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <!-- 하단 선택 회원 제어 패널 -->
                            <Border Grid.Row="4" Background="#F7F8FA" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="회원 ID" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Grid.Column="0"/>
                                        <TextBox x:Name="txtMemberId" Grid.Column="1"/>
                                        <TextBlock Text="회원 성명" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Grid.Column="3"/>
                                        <TextBox x:Name="txtMemberName" Grid.Column="4"/>
                                    </Grid>

                                    <UniformGrid Columns="3" Rows="1">
                                        <Button x:Name="btnSearch" Content="주문내역 조회" Style="{StaticResource NavyButton}" Margin="0,0,6,0" Click="btnSearch_Click"/>
                                        <Button x:Name="btnDelete" Content="회원 삭제" Style="{StaticResource DarkOutlineButton}" Margin="3,0" Click="btnDelete_Click"/>
                                        <Button x:Name="btnReset" Content="선택 초기화" Style="{StaticResource DarkOutlineButton}" Margin="6,0,0,0" Click="btnReset_Click"/>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 우측: 주문 내역(상단) 및 주문 상세 품목(하단) -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 우측 상단: 결제 이력 목록 (lvOrderHistory) -->
                        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{StaticResource NavyAccent}" BorderThickness="0,0,0,2" Padding="0,0,0,8" Grid.Row="0">
                                    <TextBlock Text="ORDER HISTORY (결제 이력)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource NavyAccent}"/>
                                </Border>
                                <ListView x:Name="lvOrderHistory" Grid.Row="2" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" SelectionChanged="lvOrderHistory_SelectionChanged">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="결제 번호" Width="120" DisplayMemberBinding="{Binding PayId}"/>
                                            <GridViewColumn Header="고객 ID" Width="150" DisplayMemberBinding="{Binding CusId}"/>
                                            <GridViewColumn Header="결제 일시" Width="240" DisplayMemberBinding="{Binding PayDate}"/>
                                            <GridViewColumn Header="총 결제 금액(원)" Width="180" DisplayMemberBinding="{Binding PayMoney}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>

                        <!-- 우측 하단: 상세 주문 도서 품목 (lvPaymentDetails) -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="22">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="12"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{StaticResource CharcoalBlack}" BorderThickness="0,0,0,2" Padding="0,0,0,8" Grid.Row="0">
                                    <TextBlock Text="ORDER DETAILS (상세 구매 품목)" FontSize="14" FontWeight="Bold" Foreground="{StaticResource CharcoalBlack}"/>
                                </Border>
                                <ListView x:Name="lvPaymentDetails" Grid.Row="2" BorderBrush="{StaticResource BorderGray}" BorderThickness="1">
                                    <ListView.View>
                                        <GridView>
                                            <GridViewColumn Header="ISBN" Width="180" DisplayMemberBinding="{Binding Isbn}"/>
                                            <GridViewColumn Header="도서명" Width="280" DisplayMemberBinding="{Binding BookName}"/>
                                            <GridViewColumn Header="수량" Width="100" DisplayMemberBinding="{Binding BookCount}"/>
                                            <GridViewColumn Header="결제 단가(원)" Width="150" DisplayMemberBinding="{Binding BookUnitPrice}"/>
                                        </GridView>
                                    </ListView.View>
                                </ListView>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================================================= -->
            <!-- 탭 2: 책 관리 (도서 판매 여부 실시간 체크/해제)                           -->
            <!-- ========================================================================= -->
            <TabItem Header="도서 판매 관리">
                <Border Margin="0,16,0,0" Background="#FFFFFF" BorderBrush="{StaticResource BorderGray}" BorderThickness="1" Padding="26">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="16"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="INVENTORY &amp; SALE STATUS" FontSize="16" FontWeight="Bold" Foreground="{StaticResource CharcoalBlack}"/>
                            <TextBlock Text="체크박스를 클릭하여 고객 화면에서의 도서 판매 가능 여부를 즉시 변경합니다." FontSize="12" Foreground="{StaticResource SubTextGray}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ListView x:Name="lvAdminBooks" Grid.Row="2" BorderBrush="{StaticResource BorderGray}" BorderThickness="1">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="판매 중" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsForSale, Mode=TwoWay}"
                                                          Click="chkIsForSale_Click"
                                                          HorizontalAlignment="Center" 
                                                          VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="ISBN" Width="180" DisplayMemberBinding="{Binding Isbn}"/>
                                    <GridViewColumn Header="도서명" Width="450" DisplayMemberBinding="{Binding BookName}"/>
                                    <GridViewColumn Header="카테고리" Width="180" DisplayMemberBinding="{Binding CategoryName}"/>
                                    <GridViewColumn Header="판매가(원)" Width="160" DisplayMemberBinding="{Binding BookPrice}"/>
                                    <GridViewColumn Header="보유 재고" Width="140" DisplayMemberBinding="{Binding BookCount}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
