            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "nullable": true
          },
          "minPrice": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "maxPrice": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
