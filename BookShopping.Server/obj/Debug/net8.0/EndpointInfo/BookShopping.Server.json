            "type": "integer",
            "format": "int32"
          },
          "payID": {
            "type": "integer",
            "format": "int32"
          },
          "isbn": {
            "type": "string",
            "nullable": true
          },
          "bookName": {
            "type": "string",
            "nullable": true
          },
          "bookCount": {
            "type": "integer",
            "format": "int32"
          },
          "bookUnitPrice": {
            "type": "integer",
            "format": "int32"
